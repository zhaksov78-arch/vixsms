DATABASE_URL="postgresql://toi:toi@localhost:5432/toi"
# Admin login (MVP). Use a long random password in production.
ADMIN_PASSWORD="change-me"
# Random string, at least 32 characters, used to sign the admin session cookie.
SESSION_SECRET="change-me-to-a-long-random-string-32+chars"
# Where uploaded photos/audio are stored on disk.
UPLOAD_DIR="./uploads"
# Public base URL (used in links and QR codes).
PUBLIC_URL="http://localhost:3000"
# WhatsApp number for the "write to us" button, digits only, e.g. 77001234567
WHATSAPP_NUMBER="77000000000"
